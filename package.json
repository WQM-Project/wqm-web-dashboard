{
  "name": "wqm-web-dashboard",
  "version": "0.0.1",
  "private": true,
  "description": "Real-time web dashboard and backend for the WQM River Water Quality Monitor",
  "repository": {
    "type": "git",
    "url": "https://github.com/WQM-Project/wqm-web-dashboard.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > types/database.ts"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "@supabase/ssr": "^0.5.0",
    "@tanstack/react-query": "^5.59.0",
    "zustand": "^5.0.0",
    "recharts": "^2.13.0",
    "leaflet": "^1.9.4",
    "react-leaflet": "^4.2.1",
    "three": "^0.169.0",
    "@react-three/fiber": "^8.17.0",
    "@react-three/drei": "^9.114.0",
    "framer-motion": "^11.11.0",
    "animejs": "^3.2.2",
    "date-fns": "^4.1.0",
    "zod": "^3.23.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.0",
    "lucide-react": "^0.451.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/leaflet": "^1.9.12",
    "@types/three": "^0.169.0",
    "@types/animejs": "^3.1.12",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.47",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.0",
    "supabase": "^1.200.0"
  }
}
