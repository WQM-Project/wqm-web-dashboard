# ---------------------------------------------------------------------------
# WQM Web Dashboard — environment template
# Copy to .env.local and fill in. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Project URL and anon key are safe in the browser: they are restricted by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row Level Security entirely.
# Must never be referenced from a client component or prefixed NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gateway ingestion ------------------------------------------------------
# Shared secret the gateway presents on POST /api/ingest.
GATEWAY_INGEST_KEY=

# --- Twilio alerting (server only) -----------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
