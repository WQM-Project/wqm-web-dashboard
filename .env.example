# ---------------------------------------------------------------------------
# WQM Web Dashboard — environment template
# Copy to .env.local and fill in. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Project URL and anon key are safe in the browser: they are restricted by RLS.
NEXT_PUBLIC_SUPABASE_URL=
# Preferred public client key. Legacy anon key remains an optional fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row Level Security entirely.
# Must never be referenced from a client component or prefixed NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gateway ingestion ------------------------------------------------------
# Shared secret the gateway presents on POST /api/ingest.
GATEWAY_INGEST_KEY=
# Comma-separated device IDs authorised to upload.
GATEWAY_ALLOWED_NODE_IDS=WQM-001
# Preferred server database configuration; legacy service-role key above also works.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional direct database tooling; credentials stay server-side.
SUPABASE_PROJECT_REF=
DATABASE_URL=
# Laptop test sender target. Set to the deployment URL for a remote test.
WQM_BACKEND_URL=http://localhost:3000

# --- Alerting (server only) -------------------------------------------------
# Twilio was dropped on cost. Alerts go out as SMS via a MacroDroid rule
# running on a dedicated Android handset, triggered by this webhook.
MACRODROID_WEBHOOK_URL=

# Fallback: ask the gateway to send SMS from its own SIM7600E/A7670C modem.
GATEWAY_SMS_CALLBACK_URL=

# Telegram is for INTERNAL team monitoring only, never authority-facing.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Machine learning service ----------------------------------------------
# Base URL of the water-quality-ml FastAPI service. Never called from the
# browser: it sets allow_origins=["*"], so it must stay behind /api/.
ML_API_URL=http://localhost:8000

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps browser key: restrict by website and Maps JavaScript API.
# Prototype mode needs only the no-billing Maps Demo Key; Google's test map ID is used.
# Production mode requires a standard key and your own JavaScript map ID.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MODE=prototype
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
